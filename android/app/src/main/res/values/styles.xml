<resources>
 <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
  <item name="colorPrimary">@color/colorPrimary</item><item name="colorPrimaryDark">@color/colorPrimaryDark</item><item name="colorAccent">@color/colorAccent</item>
  <item name="android:windowBackground">@color/lab_background</item>
  <item name="android:statusBarColor">@color/lab_background</item>
  <item name="android:navigationBarColor">@color/lab_background</item>
  <item name="android:windowLightStatusBar">true</item>
  <item name="android:windowLightNavigationBar">true</item>
 </style>
 <style name="AppTheme.NoActionBar" parent="AppTheme">
  <item name="windowActionBar">false</item><item name="windowNoTitle">true</item>
 </style>
 <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
  <item name="android:windowBackground">@drawable/splash</item>
 </style>
</resources>